{
  "name": "flutter-folder-lens",
  "displayName": "Flutter Folder Lens",
  "description": "Instantly scannable Flutter project structure — colored badges on lib/screens, widgets, models, providers, services, tests and platform folders in the Explorer.",
  "version": "0.1.0",
  "publisher": "JashwanthNeela",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "flutter",
    "dart",
    "folder",
    "colors",
    "explorer",
    "decorations",
    "badges",
    "project structure"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/NJashwanth/flutter_folder_lens.git"
  },
  "bugs": {
    "url": "https://github.com/NJashwanth/flutter_folder_lens/issues"
  },
  "activationEvents": [
    "workspaceContains:pubspec.yaml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flutterFolderLens.assignBadge",
        "title": "Assign Badge to Folder",
        "category": "Flutter Folder Lens"
      },
      {
        "command": "flutterFolderLens.refresh",
        "title": "Refresh Decorations",
        "category": "Flutter Folder Lens"
      },
      {
        "command": "flutterFolderLens.toggle",
        "title": "Toggle On/Off",
        "category": "Flutter Folder Lens"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "flutterFolderLens.assignBadge",
          "when": "explorerResourceIsFolder",
          "group": "7_modification@100"
        }
      ]
    },
    "configuration": {
      "title": "Flutter Folder Lens",
      "properties": {
        "flutterFolderLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable all folder decorations."
        },
        "flutterFolderLens.useDefaultRules": {
          "type": "boolean",
          "default": true,
          "description": "Apply the built-in rules for common Flutter folder conventions. Disable to use only your own rules."
        },
        "flutterFolderLens.rules": {
          "type": "array",
          "default": [],
          "markdownDescription": "Custom decoration rules, matched against workspace-relative folder paths. Rules listed here take priority over the built-in defaults.",
          "items": {
            "type": "object",
            "required": [
              "glob",
              "badge"
            ],
            "properties": {
              "glob": {
                "type": "string",
                "description": "Glob matched against the workspace-relative folder path, e.g. `lib/**/screens` or `packages/*/lib/models`."
              },
              "badge": {
                "type": "string",
                "maxLength": 2,
                "description": "Badge shown on the folder (max 2 characters), e.g. `▢` or `UI`."
              },
              "color": {
                "type": "string",
                "description": "Theme color id, e.g. `flutterFolderLens.blue` or any color id like `charts.red`.",
                "default": "flutterFolderLens.blue"
              }
            }
          }
        }
      }
    },
    "colors": [
      {
        "id": "flutterFolderLens.blue",
        "description": "Flutter Folder Lens: screens / pages",
        "defaults": {
          "dark": "#4FC1FF",
          "light": "#0969DA",
          "highContrast": "#4FC1FF",
          "highContrastLight": "#0969DA"
        }
      },
      {
        "id": "flutterFolderLens.cyan",
        "description": "Flutter Folder Lens: widgets",
        "defaults": {
          "dark": "#3BC9DB",
          "light": "#1B7C83",
          "highContrast": "#3BC9DB",
          "highContrastLight": "#1B7C83"
        }
      },
      {
        "id": "flutterFolderLens.orange",
        "description": "Flutter Folder Lens: models",
        "defaults": {
          "dark": "#F2994A",
          "light": "#BC4C00",
          "highContrast": "#F2994A",
          "highContrastLight": "#BC4C00"
        }
      },
      {
        "id": "flutterFolderLens.purple",
        "description": "Flutter Folder Lens: state management (providers / bloc / cubit / riverpod)",
        "defaults": {
          "dark": "#C586C0",
          "light": "#8250DF",
          "highContrast": "#C586C0",
          "highContrastLight": "#8250DF"
        }
      },
      {
        "id": "flutterFolderLens.teal",
        "description": "Flutter Folder Lens: services / repositories / data",
        "defaults": {
          "dark": "#4EC9B0",
          "light": "#1A7F6B",
          "highContrast": "#4EC9B0",
          "highContrastLight": "#1A7F6B"
        }
      },
      {
        "id": "flutterFolderLens.gray",
        "description": "Flutter Folder Lens: utils / helpers / core",
        "defaults": {
          "dark": "#9DA5B4",
          "light": "#6E7781",
          "highContrast": "#9DA5B4",
          "highContrastLight": "#6E7781"
        }
      },
      {
        "id": "flutterFolderLens.green",
        "description": "Flutter Folder Lens: tests",
        "defaults": {
          "dark": "#89D185",
          "light": "#1A7F37",
          "highContrast": "#89D185",
          "highContrastLight": "#1A7F37"
        }
      },
      {
        "id": "flutterFolderLens.yellow",
        "description": "Flutter Folder Lens: assets",
        "defaults": {
          "dark": "#E2C08D",
          "light": "#9A6700",
          "highContrast": "#E2C08D",
          "highContrastLight": "#9A6700"
        }
      },
      {
        "id": "flutterFolderLens.dimmed",
        "description": "Flutter Folder Lens: platform folders (android, ios, web, ...)",
        "defaults": {
          "dark": "#6B7280",
          "light": "#A3A9B1",
          "highContrast": "#6B7280",
          "highContrastLight": "#A3A9B1"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run check && npm run bundle",
    "check": "tsc --noEmit -p ./",
    "bundle": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "pretest": "tsc -p ./tsconfig.test.json",
    "test": "node --test out/test/",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "minimatch": "^9.0.5"
  }
}
