{
  "name": "flutter-folder-lens",
  "displayName": "Flutter Folder Lens",
  "description": "Flutter-aware file icon theme — colored, shape-based folder icons for screens, widgets, models, state management, services, tests and platform folders.",
  "version": "0.2.4",
  "publisher": "JashwanthNeela",
  "license": "MIT",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "flutter",
    "dart",
    "folder",
    "colors",
    "explorer",
    "icons",
    "icon theme",
    "decorations",
    "project structure"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/NJashwanth/flutter_folder_lens.git"
  },
  "bugs": {
    "url": "https://github.com/NJashwanth/flutter_folder_lens/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "iconThemes": [
      {
        "id": "flutter-folder-lens",
        "label": "Flutter Folder Lens",
        "path": "./theme/flutter-folder-lens-icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "flutterFolderLens.setIconForFolder",
        "title": "Set Icon for Folder…",
        "category": "Flutter Folder Lens"
      },
      {
        "command": "flutterFolderLens.regenerateIcons",
        "title": "Regenerate Icons",
        "category": "Flutter Folder Lens"
      },
      {
        "command": "flutterFolderLens.resetToDefaults",
        "title": "Reset to Defaults",
        "category": "Flutter Folder Lens"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "flutterFolderLens.setIconForFolder",
          "when": "explorerResourceIsFolder",
          "group": "7_modification@100"
        }
      ]
    },
    "configuration": {
      "title": "Flutter Folder Lens",
      "properties": {
        "flutterFolderLens.useDefaultRules": {
          "type": "boolean",
          "default": true,
          "description": "Apply the built-in icon rules for common Flutter folder conventions. Disable to use only your own rules."
        },
        "flutterFolderLens.rules": {
          "type": "array",
          "default": [],
          "markdownDescription": "Custom folder-icon rules, merged over (and winning against) the defaults. Icon themes match by **folder name only** — path targeting like `lib/models` is not possible.",
          "items": {
            "type": "object",
            "required": [
              "folderName",
              "shape",
              "color"
            ],
            "properties": {
              "folderName": {
                "type": "string",
                "description": "Folder basename to match anywhere in the tree, e.g. `genkit`."
              },
              "shape": {
                "type": "string",
                "enum": [
                  "circle",
                  "square",
                  "triangle",
                  "diamond",
                  "hexagon",
                  "star",
                  "shield",
                  "grid",
                  "gear",
                  "folder"
                ],
                "description": "Icon shape from the built-in library."
              },
              "color": {
                "type": "string",
                "description": "Palette name (blue, cyan, orange, purple, teal, gray, green, yellow, red, dimmed, …) or a #rrggbb hex color.",
                "default": "blue"
              }
            }
          }
        },
        "flutterFolderLens.baseIconTheme": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "Icon theme to use as the base under the Flutter folder overrides, so file icons are not affected. `auto` (default) = the icon theme that was active before Flutter Folder Lens, falling back to the built-in Seti theme. Or any icon theme id (e.g. `material-icon-theme`, `vs-seti`); that extension must stay installed. Empty = a minimal built-in folder/file set."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run check && npm run bundle",
    "check": "tsc --noEmit -p ./",
    "generate-theme": "esbuild src/generate-cli.ts --bundle --platform=node --format=cjs --outfile=out/generate-cli.cjs && node out/generate-cli.cjs",
    "bundle": "npm run generate-theme && esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "compile": "npm run generate-theme && esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "pretest": "rm -rf out && tsc -p ./tsconfig.test.json",
    "test": "node --test out/test/",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
